---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro bundles and runs that script in the browser, never during the build,
// so browser-only APIs (like localStorage) are safe there.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Astro bundles this <script> with Vite, so localStorage and other browser
  // APIs used here never run during the static build/SSR pass.
  import {
    STORAGE_KEY,
    DISPLAY_SEPARATOR,
    normalizeUrl,
    generateSlug,
    parseStoredBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks.ts';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  let bookmarks: Bookmark[] = load();

  function load(): Bookmark[] {
    // localStorage is untrusted: it may be empty, corrupted, hand-edited, or
    // left over from a previous version of this app. parseStoredBookmarks
    // never throws and always returns a safe array to render.
    try {
      return parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      // Reading localStorage can itself throw (e.g. disabled/blocked storage
      // in some browser privacy modes). Fail safe with an empty list.
      return [];
    }
  }

  function persist(): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Ignore storage failures (e.g. quota exceeded, storage disabled) —
      // the in-memory list still renders for the current page view.
    }
  }

  function render(): void {
    if (!list || !emptyState || !listHeader) return;

    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = DISPLAY_SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', () => copySlug(bookmark.slug, copyButton));

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  async function copySlug(slug: string, button: HTMLButtonElement): Promise<void> {
    const original = button.textContent;
    try {
      await navigator.clipboard.writeText(slug);
      button.textContent = 'Copied!';
    } catch {
      button.textContent = 'Copy failed';
    } finally {
      setTimeout(() => {
        button.textContent = original;
      }, 1500);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this first — stops the page from reloading
    if (!urlInput) return;

    const normalized = normalizeUrl(urlInput.value);
    if (!normalized) {
      urlInput.setCustomValidity('Enter a valid URL, e.g. example.com');
      urlInput.reportValidity();
      return;
    }
    urlInput.setCustomValidity('');

    const slug = generateSlug(bookmarks.map((b) => b.slug));
    bookmarks = [...bookmarks, { url: normalized, slug }];
    persist();
    render();

    form.reset();
    urlInput.focus();
  });

  urlInput?.addEventListener('input', () => {
    urlInput.setCustomValidity('');
  });

  clearAllButton?.addEventListener('click', () => {
    if (bookmarks.length === 0) return;
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    persist();
    render();
  });

  render();
</script>
